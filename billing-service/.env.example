# ============================================================
# FleetDesk — billing-service
# AUCUNE valeur réelle ici. En local : copie ce fichier en .env.
# En production : variables d'environnement de Render/Railway.
# ============================================================

# --- Serveur ---
PORT=4000
NODE_ENV=development
# Origine(s) CORS autorisées (séparées par des virgules). En production : l'URL de ton site Vercel.
CORS_ORIGIN=http://localhost:3000

# --- Supabase (clé service_role : accès total, contourne la RLS) ---
SUPABASE_URL=https://nwfzuteyhquajkwjxspb.supabase.co
# Project Settings → API → « service_role » (PAS « anon »). Le service refuse de démarrer sinon.
SUPABASE_SERVICE_ROLE_KEY=your-key-here
# --- SMTP (facultatif : sans lui, aucun e-mail n'est envoyé) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=FAKE_SMTP_PASSWORD
SMTP_FROM_NAME=FleetDesk
SMTP_FROM_EMAIL=no-reply@example.com

# --- Facturation ---
INVOICE_DUE_DAYS=15
INVOICE_VAT_RATE=19
REMINDER_MIN_INTERVAL_DAYS=3
REMINDER_CRON_SCHEDULE=0 8 * * *
# Fuseau métier (dates des PDF / e-mails / retards)
BUSINESS_TIMEZONE=Africa/Tunis
