# FleetDesk - modele de variables d'environnement (valeurs FACTICES uniquement).
# Tes vraies cles vont dans billing-service\.env et web\.env.local (fichiers ignores par Git).

# web\.env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BILLING_SERVICE_URL=http://localhost:4000

# billing-service\.env  (SECRET)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-NEVER-COMMIT

# Secrets des fonctions Supabase (poses par scripts\setup_ai.ps1)
GEMINI_API_KEY=FAKE_GEMINI_KEY
GEMINI_MODEL=gemini-3.6-flash
CRON_SECRET=FAKE_CRON_SECRET
